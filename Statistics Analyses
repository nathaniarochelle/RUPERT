#-------- Frequencies + Descriptives (NEQ) ---------------------------------------------

# Frequencies of reported negative effects (NE01) and of their attribution to the
# program or to other circumstances (NE04) per item and timepoint.


RUPERT_join_f <- RUPERT_join_f %>%
  mutate(
    NEQ01_yes_count = rowSums(across(all_of(items_NEQ01), ~ . == 2), na.rm = TRUE),
    NEQ01_any_yes = if_else(NEQ01_yes_count > 0, 1, 0)
  )

RUPERT_join_f <- RUPERT_join_f %>%
  mutate(
    NEQ04_yes_count = rowSums(across(all_of(items_NEQ04), ~ . == 1), na.rm = TRUE),
    NEQ04_any_yes = if_else(NEQ04_yes_count > 0, 1, 0)
  )

rupert26_freq_NEQ01_join <- RUPERT_join %>%
filter(state %in% c(0, 1)) %>%   
 pivot_longer(
cols = all_of(items_NEQ01),
names_to = "Item",
values_to = "Response"
) %>%
group_by(Time, Item) %>%
summarise(
 n_NE = sum(Response == 1, na.rm = TRUE),
y_NE = sum(Response == 2, na.rm = TRUE),
.groups = "drop")

rupert26_freq_NEQ04_join <- RUPERT_join %>%
filter(state %in% c(0, 1)) %>%   
pivot_longer(
cols = all_of(items_NEQ04),
names_to = "Item",
values_to = "Response"
) %>%
group_by(Time, Item) %>%
summarise(
due_to_rupert = sum(Response == 1, na.rm = TRUE),
others        = sum(Response == 2, na.rm = TRUE),
.groups = "drop")




#----------- Severity (NEQ03) --- ----------------------------------------------------

# Mean, SD, min, max and N of each severity item per timepoint (state 0/1 only),
# reshaped into a long table with one row per timepoint and item.



rupert26_NEQ03_descriptives_join <- RUPERT_join_f %>%
filter(state %in% c(0, 1)) %>%   # keep only state 0 and 1
group_by(Time) %>%
summarise(
across(
all_of(items_NEQ03),
list(
Mean = ~ mean(as.numeric(.x), na.rm = TRUE),
SD   = ~ sd(as.numeric(.x), na.rm = TRUE),
Min  = ~ min(as.numeric(.x), na.rm = TRUE),
Max  = ~ max(as.numeric(.x), na.rm = TRUE),
N    = ~ sum(!is.na(.x))
),
.names = "{.col}__{.fn}"
),
.groups = "drop"
) %>%
pivot_longer(
cols = -Time,
names_to = c("Item", ".value"),
names_sep = "__"
) %>%
arrange(Time, Item)



#--------- Severity due to RUPERT -------------------------------------------------


# For each item, restrict to cases where the negative effect was attributed to the
# intervention (NE04 == 1) and compute severity descriptives (mean, SD, min, max, N)
# per timepoint, for state 0/1 only.


rupert26_NEQ03_intervention_join <- map_dfr(seq_along(items_NEQ03), function(i) {
    
neq03_var <- items_NEQ03[i]
 neq04_var <- paste0("NE04_", sprintf("%02d", i))

RUPERT_join %>%
filter(
state %in% c(0, 1),      # keep only State 0 and 1
.data[[neq04_var]] == 1  # item-specific intervention filter
) %>%
group_by(Time) %>%
summarise(
Item = neq03_var,
Mean = mean(as.numeric(.data[[neq03_var]]), na.rm = TRUE),
SD   = sd(as.numeric(.data[[neq03_var]]), na.rm = TRUE),
Min  = min(as.numeric(.data[[neq03_var]]), na.rm = TRUE),
Max  = max(as.numeric(.data[[neq03_var]]), na.rm = TRUE),
N    = sum(!is.na(.data[[neq03_var]])),
.groups = "drop"
)})




#--------- Severity due to other situations ------------------------------------------------

# For each item, restrict to cases where the negative effect was attributed to other
# situations (NE04 == 2) and compute severity descriptives (mean, SD, min, max, N)
# per timepoint, again for state 0/1 only.

RUPERT_join %>%
filter(
state %in% c(0, 1),      # keep only State 0 and 1
.data[[neq04_var]] == 2  # item-specific intervention filter
) %>%
group_by(Time) %>%
summarise(
Item = neq03_var,
Mean = mean(as.numeric(.data[[neq03_var]]), na.rm = TRUE),
SD   = sd(as.numeric(.data[[neq03_var]]), na.rm = TRUE),
Min  = min(as.numeric(.data[[neq03_var]]), na.rm = TRUE),
Max  = max(as.numeric(.data[[neq03_var]]), na.rm = TRUE),
N    = sum(!is.na(.data[[neq03_var]])),
.groups = "drop"
)})





#--------- RQ3 -----------------------------------------------------------------------------

# Logistic regression: do age, sex and years of experience (measured at T0) predict
# whether at least one negative effect was attributed to the intervention
# (NEQ04_any_yes) at T1 and T2? One model per timepoint, state 0/1 only.


# Baseline predictors (T0)
baseline_rupert_RQ3 <- RUPERT_join_f %>%
filter(state %in% c(0, 1), Time == "T0") %>%
select(Participant_ID, SD_age, sex, SD10_01)


# T1
> t1_rupert_RQ3 <- RUPERT_join_f %>%
filter(state %in% c(0, 1), Time == "T1") %>%
select(Participant_ID, NEQ04_any_yes)

> data_RQ3 <- left_join(t1_rupert_RQ3, baseline_rupert_RQ3, by = "Participant_ID")

RQ3_T1_join <- glm(
NEQ04_any_yes ~ SD_age + sex + SD10_01,
data = data_RQ3 %>%
mutate(
SD_age  = as.numeric(as.character(SD_age)),
SD10_01 = as.numeric(as.character(SD10_01))
),
family = binomial
)

> summary(RQ3_T1_join)


# T2
t2_rupert_RQ3 <- RUPERT_join_f %>%
filter(state %in% c(0, 1), Time == "T2") %>%
select(Participant_ID, NEQ04_any_yes)

> data_RQ3_t2 <- left_join(t2_rupert_RQ3, baseline_rupert_RQ3, by = "Participant_ID")

RQ3_T2_join <- glm(
NEQ04_any_yes ~ SD_age + sex + SD10_01,
data = data_RQ3_t2 %>%
mutate(
SD_age  = as.numeric(as.character(SD_age)),
SD10_01 = as.numeric(as.character(SD10_01))
),
family = binomial(link = "logit")
)
> summary(RQ3_T2_join)
