#---------- RUPERT Data-Analysis -----------------------------------------------------------
#-------------------------------------------------------------------------------------------



# Analysis of sociodemographics and negative effects (Negative Effects Questionnaire,
# NEQ) at T0, T1 and T2.
#
# Expects the following objects in the R session (data are not part of the repository):
#   RUPERT_ori  original survey export (ID variable CASE)
#   RUPERT_HR   corrected dataset with state, Participant_ID, Time, sex (ID variable Count)
#   RUPERT26    [short description]
#   RUPERT_join_f  [short description]
#
# Coding: checkbox items (SD08, SD12, UF01): 1 = not selected, 2 = selected
#         NE01: 1 = no, 2 = yes | NE03: 1-5 severity | NE04: 1 = due to RUPERT, 2 = other



#--------- Packages ------------------------------------------------------------------------
library(dplyr)
library(tidyr)
library(ggplot2)
library(purrr)





#--------- Data cleaning and joining -------------------------------------------------------


# Convert the ID in the original dataset to character and left-join the corrected
# HR dataset (adds state, Participant_ID, Time, sex) via CASE = Count.
# state is the corrected status variable used later to filter participants (0/1).

 
RUPERT_join <- RUPERT_ori %>%
mutate(CASE = as.character(CASE)) %>%   
left_join(
RUPERT_HR %>%
mutate(Count = as.character(Count)) %>%
select(Count, state, Participant_ID, Time, sex),
by = c("CASE" = "Count"))




#--------- Sociodemographics descriptives ---------------------------------------------------


# Frequencies/percentages for sex, relationship status, professional degree,
# qualifications and employment status (paid/voluntary) at T0 and T1,
# plus mean, SD and range of age and years of experience (T0, T1). State 0/1 participants only.


